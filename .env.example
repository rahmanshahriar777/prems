# ==============================================================================
# NEO Employee Management System (EMS) — Environment Variables Reference
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=4000
APP_NAME="NEO EMS"
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:4000

# ------------------------------------------------------------------------------
# PostgreSQL Database
# ------------------------------------------------------------------------------
POSTGRES_USER=ems_admin
POSTGRES_PASSWORD=ems_secure_password_123!
POSTGRES_DB=ems_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ems_admin:ems_secure_password_123!@localhost:5432/ems_db?schema=public

# ------------------------------------------------------------------------------
# Redis & BullMQ
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# Object Storage (MinIO / S3-Compatible)
# ------------------------------------------------------------------------------
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_secure_password_123!
S3_ENDPOINT=localhost
S3_PORT=9000
S3_ACCESS_KEY=minio_admin
S3_SECRET_KEY=minio_secure_password_123!
S3_BUCKET=ems-documents
S3_USE_SSL=false
S3_REGION=us-east-1

# ------------------------------------------------------------------------------
# Authentication & Security Tokens
# ------------------------------------------------------------------------------
# Generate random 64-char keys for production: openssl rand -base64 48
JWT_ACCESS_SECRET=ems_super_secret_access_jwt_key_development_only_change_in_prod_123!
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=ems_super_secret_refresh_jwt_key_development_only_change_in_prod_456!
JWT_REFRESH_EXPIRATION=7d

# Rate Limiting (Throttler)
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ------------------------------------------------------------------------------
# Logging & Observability
# ------------------------------------------------------------------------------
LOG_LEVEL=debug
METRICS_PORT=9090

